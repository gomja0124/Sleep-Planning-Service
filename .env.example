GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
# 여러 줄 키는 \n 문자로 연결해 한 줄로 넣습니다.
APPLE_PRIVATE_KEY=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# 로컬에서 같은 날 수면 기록을 여러 건 쌓아 추천 모델을 검증합니다.
SLEEP_RECORD_TEST_MODE=true
# 로그인 없이 데모 계정으로 모든 API를 열어 줍니다. DJANGO_DEBUG=false면 무시됩니다.
DJANGO_ALLOW_DEMO_USER=true
FRONTEND_ORIGIN=http://localhost:4173

# ── 배포할 때만 ────────────────────────────────────────────────
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=  # 필수. 없으면 서버가 뜨지 않습니다.
# DJANGO_ALLOWED_HOSTS=api.example.com   # 쉼표로 여러 개
# FRONTEND_ORIGIN=https://gomja0124.github.io   # CORS·쿠키·로그인 리디렉션 기준
# DATABASE_URL=postgres://...            # 없으면 SQLite라 재배포마다 초기화됩니다
